+def _quantize_draft_weight(weight: torch.Tensor, mode: str):
+    from vllm.models.inkling2.nvidia.ops.gemv_q4 import (
+        quantize_int4_group,
+        quantize_rows,
+    )
+
+    if mode == "int8":
+        return ("int8", quantize_rows(weight, "int8"))
